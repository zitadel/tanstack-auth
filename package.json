{
  "name": "@zitadel/tanstack-auth",
  "description": "A comprehensive authentication integration for TanStack Start applications with TypeScript support and session management",
  "version": "1.1.3",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./adapters": {
      "types": "./dist/adapter.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/tanstack-auth.git"
  },
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang@zitadel.com",
    "url": "https://github.com/zitadel"
  },
  "scripts": {
    "prepack": "tsc",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --verbose --config=jest.config.mjs --runInBand --passWithNoTests",
    "test:watch": "npm run test:unit -- --watch",
    "typecheck": "tsc --noEmit",
    "test:debug": "jest --verbose --config=jest.config.mjs --runInBand --detectOpenHandles",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "npm run build",
    "build": "tsup",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "npx eslint . --fix",
    "depcheck": "npx knip",
    "docs": "typedoc"
  },
  "peerDependencies": {
    "@tanstack/react-start": ">=1.0.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@jest/globals": "^30.0.5",
    "@mridang/eslint-defaults": "^1.6.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "jest": "30.4.2",
    "jest-junit": "^17.0.0",
    "knip": "^6.26.0",
    "prettier": "^3.6.2",
    "semantic-release": "^25.0.3",
    "ts-jest": "29.4.11",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.7",
    "typescript": "^7.0.2",
    "@playwright/test": "^1.52.0",
    "testcontainers": "^12.0.0"
  },
  "keywords": [
    "auth",
    "authentication",
    "authorization",
    "authn",
    "authz",
    "oauth",
    "oidc",
    "authjs",
    "jwt",
    "jwks",
    "pkce",
    "tanstack",
    "tanstack-start",
    "react"
  ],
  "private": false,
  "homepage": "https://github.com/zitadel/tanstack-auth",
  "bugs": "https://github.com/zitadel/tanstack-auth/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@auth/core": "^0.41.2"
  },
  "overrides": {
    "h3": "^1.15.11",
    "nitropack": "^2.13.4",
    "serialize-javascript": "^7.0.5",
    "@tanstack/start-server-core": "^1.169.8",
    "js-yaml": "^4.1.1"
  }
}
